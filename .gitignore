# Zephyr/west build output - regenerated by tools/build.ps1
build/

# Python
__pycache__/
*.pyc

# Editor
.vscode/

# Scratch build logs from this session
build_log*.txt

# Third-party public dataset (719 MB, re-downloadable) - not our data, not
# committing it to history. Our own recordings under data/<position>/ are not
# excluded.
data/sisfall/

# Working copy extracted from an archived release zip by the OTA tooling.
firmware/*.extracted.bin

# Telegram bot token + ntfy topic, shipped NEXT TO FD Studio.exe (which is
# committed and holds no secret). This file is the secret: never commit it.
alerts.bundle.json

# release/ is the folder you zip and send. Only the exe and its instructions
# are tracked; the token file above, and anything the exe creates when run
# from here (data/, firmware/, logs), stay local.
release/*
!release/FD Studio.exe
!release/START HERE.txt
